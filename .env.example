# Base URL for the API layer (src/Api/apicall/axiosInstance.js)
VITE_API_BASE_URL=/api

# When true, contact + newsletter API calls resolve locally without a backend.
# Set to false once the backend endpoints exist.
VITE_MOCK_API=true

# Google Apps Script Web App URL for Google Sheets logging + automated email dispatch
# Setup instructions in scripts/google-sheets-registration.gs
VITE_REGISTRATION_SHEET_URL=

# FormSubmit.co recipient email (optional fallback/alternative for email notifications)
VITE_FORMSUBMIT_EMAIL=
